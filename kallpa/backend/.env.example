# Copia este archivo a .env y ajusta los valores. Ninguna clave es obligatoria para la demo.
DATABASE_URL=sqlite:///./kallpa.db
# Carga datos de demostración al iniciar (true/false)
SEED_DEMO=true

# --- Transcripción local (faster-whisper) ---
WHISPER_MODEL=base
WHISPER_MODEL_DIR=./models
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Gemini (solo 1 solicitud por negocio, para proponer la estructura inicial) ---
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=cambia-este-token
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Orígenes permitidos para la app web (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost

# Copia este archivo a .env y ajusta los valores. Ninguna clave es obligatoria para la demo.
DATABASE_URL=sqlite:///./kallpa.db
# Carga datos de demostración al iniciar (true/false)
SEED_DEMO=true

# --- Transcripción local (faster-whisper) ---
WHISPER_MODEL=base
WHISPER_MODEL_DIR=./models
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Gemini (solo 1 solicitud por negocio, para proponer la estructura inicial) ---
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=cambia-este-token
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Orígenes permitidos para la app web (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_TEMPLATE_RESUMEN=

# Agente de IA (Women2) en el chat de la app y en WhatsApp: entiende texto y audio con Gemini
AGENT_ENABLED=false
AGENT_MODEL=gemini-3.8-flash
AGENT_VOICE_REPLY=true
EDGE_TTS_VOICE=es-PE-CamilaNeural
# URL pública del backend (para que WhatsApp descargue los audios de respuesta)
APP_BASE_URL=

# ---- WhatsApp por Twilio (Sandbox: funciona sin verificar el negocio en Meta) ----
# WHATSAPP_ENABLED=true
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_JOIN_CODE=join palabra-clave

# ---- WhatsApp gratis con el puente (carpeta bridge/, vinculado por QR) ----
# WHATSAPP_ENABLED=true
# WHATSAPP_PROVIDER=bridge
# BRIDGE_SECRET=kallpa-2026
# WHATSAPP_DISPLAY_NUMBER=519XXXXXXXX
